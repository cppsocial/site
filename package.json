{
  "type": "module",
  "scripts": {
    "build:frontend": "node frontend/build.mjs",
    "format:frontend": "prettier --write \"frontend/**/*.{ts,mjs,json}\" \"vitest.config.ts\"",
    "check:frontend": "prettier --check \"frontend/**/*.{ts,mjs,json}\" \"vitest.config.ts\"",
    "lint:frontend": "eslint \"frontend/**/*.{ts,mjs}\" \"vitest.config.ts\"",
    "typecheck:frontend": "tsc --noEmit -p frontend/tsconfig.json && tsc --noEmit -p frontend/tsconfig.migration.json && tsc --noEmit -p frontend/tsconfig.worker.json",
    "test:frontend": "vitest run",
    "check:assets": "prettier --check \"assets/**/*.{css,html}\"",
    "format:assets": "prettier --write \"assets/**/*.{css,html}\"",
    "check:yaml": "prettier --check \"**/*.yaml\"",
    "format:yaml": "prettier --write \"**/*.yaml\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "24.13.3",
    "esbuild": "0.25.9",
    "eslint": "^10.10.0",
    "jsdom": "26.1.0",
    "prettier": "3.9.6",
    "typescript": "5.9.2",
    "typescript-eslint": "^8.70.0",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "@cppsocial/codeblocks": "^0.1.2",
    "minisearch": "7.2.0"
  }
}
