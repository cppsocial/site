{
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "strict": true,
    "target": "ES2022",
    "types": ["node", "vitest/globals"]
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "../vitest.config.ts"],
  "exclude": [
    "src/directory/search.ts",
    "src/pages/directory.ts",
    "src/pages/packages.ts",
    "src/workers"
  ]
}
